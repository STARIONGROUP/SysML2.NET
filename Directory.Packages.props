<?xml version="1.0" encoding="utf-8"?>

<Project>

    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>

    <!--
        Floored packages - single source of truth. The redistributable libraries multi-target
        netstandard2.1, where the referenced version becomes a minimum floor for every downstream
        consumer, so these stable framework abstractions stay at an LTS version and are mirrored in
        IGNORE_PACKAGES in .github/workflows/nuget-reference-check.yml (outdated check only):

          Microsoft.Extensions.DependencyInjection.Abstractions
          Microsoft.Extensions.Logging.Abstractions
          System.Collections.Immutable
          System.IO.Pipelines
          Microsoft.NETCore.Platforms   (transitive)
          Microsoft.NETCore.Targets     (transitive)

        Raise a floored version only when a required API needs it or a CVE affects that package.
    -->
    <ItemGroup Label="Floored to LTS">
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
        <PackageVersion Include="System.Collections.Immutable" Version="8.0.0" />
        <PackageVersion Include="System.IO.Pipelines" Version="8.0.0" />
    </ItemGroup>

    <ItemGroup Label="Libraries">
        <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0" />
        <PackageVersion Include="MessagePack" Version="3.1.8" />
        <PackageVersion Include="Microsoft.Sbom.Targets" Version="4.1.5" />
        <PackageVersion Include="System.Text.Json" Version="10.0.11" />
    </ItemGroup>

    <ItemGroup Label="Code generator">
        <PackageVersion Include="Antlr4.Runtime.Standard" Version="4.13.1" />
        <PackageVersion Include="Microsoft.CodeAnalysis" Version="5.9.0" />
        <PackageVersion Include="Microsoft.OpenApi" Version="3.10.2" />
        <PackageVersion Include="uml4net.HandleBars" Version="9.1.0" />
        <PackageVersion Include="uml4net.Reporting" Version="9.1.0" />
        <PackageVersion Include="uml4net.xmi.Extensions.EnterpriseArchitect" Version="9.1.0" />
    </ItemGroup>

    <ItemGroup Label="Tests">
        <PackageVersion Include="coverlet.collector" Version="10.0.1" />
        <PackageVersion Include="coverlet.msbuild" Version="10.0.1" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
        <PackageVersion Include="Moq" Version="4.20.72" />
        <PackageVersion Include="NUnit" Version="4.6.1" />
        <PackageVersion Include="NUnit.Console" Version="3.22.0" />
        <PackageVersion Include="NUnit3TestAdapter" Version="6.3.0" />
        <PackageVersion Include="Serilog" Version="4.4.0" />
        <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
        <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageVersion Include="XMLUnit.Core" Version="2.11.2" />
    </ItemGroup>

</Project>
