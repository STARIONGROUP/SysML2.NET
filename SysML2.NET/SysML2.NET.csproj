<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
        <LangVersion>14.0</LangVersion>
        <Version>0.25.0</Version>
        <Description>A .NET implementation of the OMG SysML v2 specification.</Description>
        <PackageId>SysML2.NET</PackageId>
        <Company>Starion Group S.A.</Company>
        <Copyright>Copyright © Starion Group S.A.</Copyright>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/STARIONGROUP/SysML2.NET.git</RepositoryUrl>
        <RepositoryType>Git</RepositoryType>
        <Authors>Sam Gerené</Authors>
        <RequireLicenseAcceptance>true</RequireLicenseAcceptance>
        <PackageReleaseNotes>
            [Add] PSM DTOs declare their PIM counterpart through IPimMappable&lt;TRecord&gt;, IRequest&lt;TRecord&gt; and IResponse&lt;TRecord&gt;; PimMapper, ConstraintMapper and MergeResultMapper translate between the two models (#389)
            [Update] Metamodel, textual grammar and generated code aligned with the SysML v2 2026-08 release (#383)
            [Update] PIM members carry a Property attribute holding the xmi:id and multiplicity from the normative API PIM model (ptc/25-02-29)
            [Fix] PIM types aligned with the normative API PIM model: PrimitiveConstraint specializes Constraint, Commit.PreviousCommits replaces Commit.PreviousCommit, and Commit.Change, Commit.VersionedData, Project.Branches, Project.Tags, Project.CommitReferences, Query.Project, Query.OrderBy and DataVersion.project are added (#388)
            [Fix] Derived-property and operation implementations corrected after a verification round against the specification (#385)
        </PackageReleaseNotes>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <GenerateSBOM>true</GenerateSBOM>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="Microsoft.Sbom.Targets" />
        <PackageReference Include="System.Collections.Immutable" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SysML2.NET.Dal" />
        <InternalsVisibleTo Include="SysML2.NET.Dal.Tests" />
        <InternalsVisibleTo Include="SysML2.NET.Serializer.Json" />
        <InternalsVisibleTo Include="SysML2.NET.Serializer.Xmi" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SysML2.NET.Tests" />
        <InternalsVisibleTo Include="SysML2.NET.Semantics.Tests" />
    </ItemGroup>
</Project>